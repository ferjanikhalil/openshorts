# deploy/publisher/.env — copy to `.env` beside this file and fill in.
#
# ONLY for the "box you control" path (README Appendix A): docker-compose.yml, an
# always-on process, its own Postgres. The Hugging Face Space in the main runbook
# needs none of this — its configuration lives in the Space's secrets, and its
# database is Supabase. Filling this in for the Space is wasted work.
#
# This file is the template; `.env` itself is gitignored (.gitignore:28 matches it
# at any depth, verified). Nothing here belongs in a commit, a compose file, or a
# screenshot.

# --- The database this host owns ---------------------------------------------
# Generate a password with no URL-special characters, because it is interpolated
# into a DATABASE_URL and an @ or : would silently corrupt the connection string:
#   openssl rand -hex 24
POSTGRES_PASSWORD=
POSTGRES_USER=openshorts
POSTGRES_DB=openshorts

# --- Who may reach what ------------------------------------------------------
# This host's private tailnet address (`tailscale ip -4`), e.g. 100.101.102.103.
# Postgres is published on this address ONLY, so the app host can connect and the
# public internet cannot. Leave it unset and the database stays container-local —
# correct for a publisher that runs alone, useless for a shared queue.
DB_BIND_ADDR=
# Same idea for the publisher's HTTP port. Loopback by default; use the tailnet
# address to reach the admin API, or a public bind only behind TLS (see README).
PUBLISHER_BIND_ADDR=127.0.0.1

# --- Credential sealing ------------------------------------------------------
# MUST BE BYTE-IDENTICAL TO THE APP HOST'S PUBLISHING_MASTER_KEY.
#
# This is the single most consequential line in the file. The provider API key
# lives in the shared database sealed with AES-256-GCM; this key is what unwraps
# it. A different key here does not fail at boot — it fails at the first submit,
# as an authentication error against the provider, which reads exactly like a
# revoked API key and sends you to the wrong dashboard. Copy it across; do not
# generate a new one.
PUBLISHING_MASTER_KEY=
# Only during a rotation window, and again identical on both hosts.
PUBLISHING_MASTER_KEY_OLD=

# --- Admin identity ----------------------------------------------------------
# Without one of these the admin router stays unmounted, which is the safe
# failure but also means this host cannot be inspected or corrected remotely.
# 32+ random bytes: openssl rand -hex 32
PUBLISHING_ADMIN_TOKEN=
# Cloud mode only (JWT identities). Ignored in self-host.
PUBLISHING_ADMIN_EMAILS=

# --- Where the provider fetches clips and confirms posts ---------------------
# The origin the PROVIDER reaches, not one you reach. Point it at this host once
# it has a public HTTPS name (README's webhook step); until then leave whatever
# the app host uses. It is only used for webhook callbacks while the media
# strategy is objectstore_presigned, so a stale value here delays confirmations
# rather than breaking posts.
PUBLISHING_PUBLIC_BASE_URL=

# --- Media store: the same bucket the app host stages into --------------------
# These must match the app host exactly. The app host uploads the clip; this host
# presigns a URL for the object it uploaded. Different buckets and every post
# parks forever waiting for media that was staged somewhere else.
PUBLISHING_S3_ENDPOINT=
PUBLISHING_S3_BUCKET=
PUBLISHING_S3_REGION=
PUBLISHING_S3_ACCESS_KEY_ID=
PUBLISHING_S3_SECRET_ACCESS_KEY=

# --- Behaviour ---------------------------------------------------------------
# Set to 1 for a first boot against the fake provider: the full queue, retry and
# webhook path runs with no credential and nothing reaching a real audience.
PUBLISHING_DRY_RUN=
# Leave unset. No provider currently holds a schedule (see providers/status200.py),
# so `auto` behaves like `off` and this host's clock is what spaces posts out.
# `on` forces the field on anyway and is for diagnostics only — it would release
# a whole spread plan to submit at once.
PUBLISHING_REMOTE_SCHEDULE=

# Slots are stored as timestamptz, so correctness does not depend on this; it
# only decides what the container's log lines say.
TZ=UTC
