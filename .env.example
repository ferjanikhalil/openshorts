# AWS S3 (optional — for clip backup/gallery)
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_REGION=eu-west-3
AWS_S3_BUCKET=your-bucket-name
AWS_S3_PUBLIC_BUCKET=your-public-bucket-name

# Concurrent processing limit (default: 5)
# MAX_CONCURRENT_JOBS=5

# How long finished jobs (clips + source) are kept on disk before the cleanup
# sweep deletes them, in seconds. Default 86400 (24h). This is also how long a
# project stays re-openable from the header's "Recent" menu in self-host mode.
# Raise it to keep projects around longer, lower it to reclaim disk sooner.
# JOB_RETENTION_SECONDS=86400

# YouTube cookies (optional — paste Netscape-format cookies to bypass bot detection)
# YOUTUBE_COOKIES=...

# Google OAuth (cloud/billing mode only). When logging in through a proxy whose
# Host header doesn't match a Google-registered URI (e.g. local dev via the Vite
# proxy), pin the callback explicitly:
# OAUTH_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
# FRONTEND_URL=http://localhost:5175

# Local dev: show the full pipeline logs (yt-dlp/ffmpeg/debug) in the UI even
# when running in paid mode (BILLING_ENABLED). Cloud/prod leaves this unset.
# DEBUG_LOGS=true

# Pre-flight quality gate: warn before processing a YouTube source below this
# height (720p default; 0 disables). Only applies to URL sources.
# QUALITY_GATE_MIN_HEIGHT=720

# Whisper transcription model (main pipeline). "small" is better than "base" on
# non-English audio; "base" is faster. device/compute for GPU tuning.
# Prod GPU: WHISPER_MODEL=large-v3-turbo WHISPER_DEVICE=cuda WHISPER_COMPUTE=float16
# WHISPER_MODEL=small
# WHISPER_DEVICE=cpu
# WHISPER_COMPUTE=int8

# Transcription backend: whisper (default) | parakeet. Parakeet (NVIDIA
# parakeet-tdt-0.6b-v3 via onnx-asr, GPU image only) is ~2x faster than
# whisper-turbo-GPU and auto-falls-back to whisper on errors or languages
# outside its 25 European ones.
# TRANSCRIBE_BACKEND=whisper

# Concurrent GPU transcriptions (parakeet or whisper-on-cuda). Keep 1.
# ASR_GPU_CONCURRENCY=1

# Video encoder for all ffmpeg encodes: x264 (default) | nvenc | auto.
# auto probes h264_nvenc once at startup and falls back to x264 if unusable.
# FFMPEG_ENCODER=x264

# ─── LLM Provider (clip analysis) ─────────────────────────────────────────────
# Provider selection: gemini (default) | openai_compat
# If unset and GEMINI_API_KEY is present, Gemini is used automatically.
# LLM_PROVIDER=gemini

# Gemini (existing — unchanged)
# GEMINI_API_KEY=your_gemini_key_here
# GEMINI_MODEL=gemini-3.1-flash-lite

# OpenAI-compatible endpoint (NVIDIA NIM, OmniRoute, OpenRouter, LiteLLM, vLLM, LM Studio, Ollama)
# Only used when LLM_PROVIDER=openai_compat
# OPENAI_BASE_URL=http://localhost:20128/v1
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=besto

# ─── Automated publishing ─────────────────────────────────────────────────────
# Optional subsystem, independent of BILLING_ENABLED: posts finished clips to
# social accounts through a provider (Status 200 is the first adapter). Off by
# default — every /api/publishing route 404s and the dashboard hides the tab.
#
# NO PROVIDER API KEY BELONGS IN THIS FILE. Status 200 keys are entered through
# the app's admin UI (Publishing → Accounts → credential), encrypted with
# AES-256-GCM before they touch the database, and never returned to the frontend
# — only a fingerprint and last4. Do not put one here, in Git, or in a log.
# PUBLISHING_ENABLED=true

# Requires Postgres. Duplicate-post prevention, retry state and the audit trail
# are durability requirements; an in-memory guard that forgets on redeploy is not
# a guard. Startup fails fast if this is missing while publishing is enabled.
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/openshorts

# Master key that wraps every stored provider credential. 32 bytes, base64.
# Generate: python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
# Losing it means every stored credential must be re-entered. Rotate by moving
# the current value to PUBLISHING_MASTER_KEY_OLD and setting a new one — old
# ciphertext stays readable and re-wraps on next use, then drop the OLD value.
# PUBLISHING_MASTER_KEY=
# PUBLISHING_MASTER_KEY_OLD=

# Who may reach the admin routes (credentials, groups, accounts). At least one is
# required or the admin router stays unmounted and the UI says so. The token is
# for self-host (sent as a bearer header); the email list authorises signed-in
# Google accounts in cloud mode.
# PUBLISHING_ADMIN_TOKEN=
# PUBLISHING_ADMIN_EMAILS=you@example.com

# Public origin the PROVIDER fetches media from — not the browser's origin.
# Status 200 ingests by URL, so a clip must be reachable from the public
# internet. Falls back to FRONTEND_URL, which is right for a single-origin
# deploy. Localhost will not work: the provider cannot reach your laptop.
# Still needed with an object store configured (below): it is also where the
# provider's webhook lands, and an unconfirmed post ends up as `unknown`.
# PUBLISHING_PUBLIC_BASE_URL=https://app.example.com
# PUBLISHING_MEDIA_URL_TTL=3600

# How long the URL handed to the PROVIDER stays valid. Status 200 does not copy
# the bytes when media is registered — it keeps the URL and downloads from it
# when the post goes out, which for a scheduled post is days later. So this has
# to outlive the media ref (7 days), and 7 days is also the maximum a presigned
# S3 URL can have. Only lower it if every post is immediate.
# PUBLISHING_PROVIDER_MEDIA_URL_TTL=604800

# --- Media staging (strongly recommended; required on a home connection) -----
# Without this, the provider downloads each clip from THIS machine, inside its
# own submit request — so your upload speed becomes a hard requirement. Measured
# on a home line: a 21.7 MB clip took 244 s to leave the box, the provider's
# gateway gave up first and returned a bodyless 504, which is `unknown` and is
# never auto-retried. Every post then needs a human.
#
# Point these at any S3-compatible bucket and the slow transfer moves to a
# background loop that runs ahead of the slot; the provider gets a presigned URL
# and downloads from a datacenter in seconds. Works with Supabase Storage,
# Backblaze B2, Cloudflare R2, MinIO and AWS S3 — Supabase's and B2's free tiers
# are enough (the working set is a few ~20 MB clips at a time) and Supabase's
# needs no card. Use a PRIVATE bucket: access is by presigned URL only.
#
# Region matters for Supabase (use the project's region) and must be "auto" for
# R2. Leave PUBLISHING_S3_ENDPOINT empty for real AWS.
# PUBLISHING_S3_ENDPOINT=https://<project-ref>.storage.supabase.co/storage/v1/s3
# PUBLISHING_S3_BUCKET=openshorts-publishing
# PUBLISHING_S3_REGION=eu-central-1
# PUBLISHING_S3_ACCESS_KEY_ID=
# PUBLISHING_S3_SECRET_ACCESS_KEY=
#
# If these are unset, R2_* then AWS_* (the S3 backup keys above) are used
# instead, so a deploy that already has object storage needs nothing new here.
#
# Check the provider's per-object ceiling: Supabase's free plan caps an upload at
# 50 MB, which a long or high-bitrate clip can exceed. Staging then fails
# permanently and logs a `media.stage_failed` event while the post stays parked.
#
# Staging loop: TRANSFER_INTERVAL is idle polling only (a pass that uploads
# something loops again immediately). STORE_RETENTION_HOURS is how long a staged
# object outlives the last post that needed it — objects for still-queued posts,
# or for a provider media ref that has not expired, are never swept whatever
# their age. Budget roughly 25 MB per clip for about nine days (7-day provider
# ref + this window), so 1 GB comfortably covers ~3 posts a day. Set 0 to
# disable the sweep and use the bucket's own lifecycle rule instead.
# PUBLISHING_TRANSFER_INTERVAL=15
# PUBLISHING_STORE_RETENTION_HOURS=48

# Dry run: the whole pipeline (queue, retries, webhooks, UI) runs end to end
# against an in-repo fake provider. No credential needed, no real post made.
# Leave this on until you have verified the flow with test accounts.
# PUBLISHING_DRY_RUN=true

# Provider adapter for new groups. status200 is the only one shipped.
# PUBLISHING_DEFAULT_PROVIDER=status200

# Queue tuning. Attempts back off 60s → 1h, capped at MAX_ATTEMPTS tries.
# PER_CREDENTIAL_CONCURRENCY stays at 1 so one throttled key cannot stall the
# other groups. SUBMIT_TIMEOUT is how long a handed-off-but-unconfirmed post
# waits before it is parked as `unknown` (never auto-retried — a blind retry can
# double-post to a real audience).
# PUBLISHING_MAX_ATTEMPTS=5
# PUBLISHING_DISPATCH_INTERVAL=5
# PUBLISHING_RECONCILE_INTERVAL=60
# PUBLISHING_SUBMIT_TIMEOUT=1800
# PUBLISHING_MAX_CONCURRENT_UPLOADS=4
# PUBLISHING_PER_CREDENTIAL_CONCURRENCY=1

# Minimum seconds between two provider media registrations. Only bites on the
# signed-token route, where the provider pulls the whole clip from YOUR origin:
# back-to-back registrations saturate a home uplink / free tunnel — the
# congestion spiral that failed a full day's posts on 2026-08-15. One per gap is
# the ceiling a self-host can serve. With PUBLISHING_S3_* configured the
# registration is a tiny JSON call and this barely matters.
# PUBLISHING_MEDIA_REGISTRATION_GAP=90

# Who holds the clock for a scheduled post. "auto" hands the timestamp to the
# provider when that provider declares it honours one — this machine may then be
# off when the slot arrives. "off" always keeps the clock here, where the attempt
# stays cancellable until it submits, at the cost of having to be awake at every
# slot. "on" forces hand-over even against the declared capability (diagnostics
# only — it is how you re-test a provider that used to ignore the field).
#
# As shipped, "auto" behaves like "off", because no provider declares support:
# Status 200 documents `post.scheduledFor` and does not honour it. Measured over
# three real posts — including one in the exact documented `...000Z` shape, so
# the format was never the cause — and a probe of both API hosts found a single
# handler that only creates posts, with no other endpoint where scheduling could
# live. So every slot is held HERE, which means the container must be running
# when a slot arrives. An always-on host is the only thing that removes that
# requirement; nothing free can make Status 200 hold a clock.
#
# If a provider ever starts honouring the field and then stops, the log says
# `attempt.remote_schedule_ignored` and hand-over disables itself after ONE post
# rather than a day's worth.
# PUBLISHING_REMOTE_SCHEDULE=auto

# --- Role, for a split deployment (see deploy/publisher/README.md) ---
# "full" (default) or "publisher". Only health reads it, and only to tell two
# identical-looking states apart: an instance with no clip resolver registered is
# broken if it is meant to own the video pipeline, and correct if it is an
# always-on host that holds the schedule clock and no clip files. Nothing else
# infers behaviour from it — the loops, the queue and the guards are the same
# code on both hosts. Declared rather than detected, because only the operator
# knows which of the two a resolver-less instance is, and guessing "publisher"
# would hide a genuinely broken app host behind the exemption.
# PUBLISHING_ROLE=full

# --- Knobs that only matter once TWO processes share the queue ---
# How long an `in_flight` claim must have gone quiet before boot recovery treats
# it as abandoned and re-queues it. With one long-lived process this was free:
# boot meant nothing was in flight. It is not free when the app host and a
# scheduled publisher (deploy/publisher/) share one database, because then a
# recovery pass regularly runs while the other process is mid-batch — and
# re-queuing a claim someone is still working through is how one clip becomes two
# posts. The default outlasts the slowest legitimate dispatch (a media
# registration plus a submit, each bounded by the provider client's timeouts).
# This is thrash avoidance, not the safety boundary: that is the claim-ownership
# re-check in dispatcher.dispatch_attempt, which holds no matter what you set here.
# PUBLISHING_ORPHAN_CLAIM_MIN_AGE=900

# Wall-clock budget for one `python -m publishing.tick` pass, for hosts that offer
# scheduled runs rather than an always-on process. The scheduled host imposes its
# own timeout and kills the process when it expires, stranding whatever claim was
# open; the tick therefore stops on its own terms first and leaves the rest for
# the next run. Keep it comfortably BELOW the host's function timeout.
# PUBLISHING_TICK_BUDGET_SECONDS=600
